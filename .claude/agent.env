#!/bin/bash
# ASDF environment initialization for Claude Code (VS Code extension / agent shells)
# Run this manually with: source .claude/agent.env
#
# Adapted 2026-11-19 (ADR-0002) for this machine: WSL2 + asdf >= 0.16, which is a
# single Go binary that only needs its shims dir on PATH — the old `asdf.sh` script
# no longer exists. Legacy (bash asdf) and macOS Homebrew paths are still honored if
# present. Reports what it actually found instead of printing success unconditionally.

ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
export PATH="$ASDF_DATA_DIR/shims:$HOME/.local/bin:$PATH"
[ -d /opt/homebrew/bin ] && export PATH="/opt/homebrew/bin:$PATH"

# Legacy bash-asdf (< 0.16) installs still ship asdf.sh; source it only if it exists.
for f in "${ASDF_DIR:+$ASDF_DIR/asdf.sh}" "$ASDF_DATA_DIR/asdf.sh" \
         /opt/homebrew/opt/asdf/libexec/asdf.sh /usr/local/opt/asdf/libexec/asdf.sh; do
  if [ -n "$f" ] && [ -f "$f" ]; then . "$f"; break; fi
done

if command -v asdf >/dev/null 2>&1; then
  echo "✅ asdf $(asdf --version 2>/dev/null | awk '{print $3}') — shims: $ASDF_DATA_DIR/shims"
else
  echo "⚠️  asdf not found on PATH — runtimes will fall back to whatever else is installed"
fi
echo "Node: $(command -v node || echo 'not found') $(node --version 2>/dev/null)"
echo "Python: $(command -v python3 || echo 'not found') $(python3 --version 2>/dev/null)"
